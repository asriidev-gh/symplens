ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
DATABASE_URL=
# Comma-separated web origins allowed to call the API (the Expo web build). Localhost is allowed automatically in development.
CORS_ORIGINS=

# --- Abuse and cost protection ---
# Shared counters across server instances (strongly recommended in production; without it limits are per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Number of proxies you trust in front of the API (client IP = the entry that many from the right of X-Forwarded-For).
# Must run behind a proxy that sets X-Forwarded-For (Vercel, Fly, nginx, ALB...). Without one every caller is "unknown".
TRUSTED_PROXY_HOPS=1
# Global daily caps on model calls (UTC day). The 80% and exhaustion events are logged: alert on them.
DAILY_ANALYSIS_LIMIT=3000
DAILY_AUX_LIMIT=6000

# Paywall: when true, /api/analyze, /followup and /translate need an active RevenueCat "pro" entitlement
# (emergency guidance stays free). Use a SECRET v1 API key from RevenueCat; never ship it in the app.
REQUIRE_SUBSCRIPTION=false
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
# Fair-use cap per subscriber per UTC month (only enforced when REQUIRE_SUBSCRIPTION=true)
MONTHLY_ANALYSIS_LIMIT=60
MONTHLY_AUX_LIMIT=300
